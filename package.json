{
  "name": "rimbun",
  "version": "0.1.0",
  "private": true,
  "imports": {
    "@/*": "./src/*"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests e2e",
    "test": "node --import ./tests/register.mjs --test --experimental-strip-types tests/*.test.ts tests/reference-search.test.ts",
    "test:integration": "node --import ./tests/register.mjs --test --experimental-strip-types tests/integration/**/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "reference-data:build": "node scripts/reference-data/build-all.mjs",
    "netlify:status": "pnpm --package=netlify-cli dlx netlify status",
    "netlify:link": "pnpm --package=netlify-cli dlx netlify link --name rimbun",
    "netlify:deploy": "pnpm --package=netlify-cli dlx netlify deploy",
    "netlify:deploy:prod": "pnpm --package=netlify-cli dlx netlify deploy --prod"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.90.1",
    "@tiptap/extension-placeholder": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "lottie-react": "^2.4.1",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.8.0",
    "tailwind-merge": "^3.6.0",
    "tldraw": "^5.0.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "@playwright/test": "^1.55.0",
    "typescript": "^5"
  }
}
