# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# /diagnose (public AI pain checker)
# Anthropic API key used for Claude Sonnet 5.5. Server-only.
ANTHROPIC_API_KEY=
# Random secret used to hash client IPs for rate limiting (e.g. `openssl rand -hex 32`).
DIAGNOSE_IP_SALT=
# Maximum AI calls per day across all users (default 500).
DIAGNOSE_DAILY_CAP=500
# Local development only: return canned AI responses instead of calling the API.
# DIAGNOSE_FAKE_AI=1

# Care Loop secure links (/r and /referral)
# Secret used to sign the patient verification cookie (e.g. `openssl rand -hex 32`).
# Falls back to SUPABASE_SERVICE_ROLE_KEY when unset.
LOOP_LINK_SECRET=
# Public origin used in links sent to patients and specialists (defaults to the request host).
# NEXT_PUBLIC_SITE_URL=https://rimbun.app
# Time zone used to display Care Loop dates (default Asia/Kuala_Lumpur).
# NEXT_PUBLIC_CLINIC_TIME_ZONE=Asia/Kuala_Lumpur
